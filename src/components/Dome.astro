---
// The Masjid Hearts mark, drawn one heart at a time: a dome that only exists because hearts gather.
import dome from '../data/dome.json';
const n = dome.hearts.length;
---
<svg class="dome" viewBox="4400 4150 12200 12700" aria-hidden="true">
  <g fill="#CFB083">
    {dome.hearts.map((d, i) => <path class="heart" style={`--i:${i}`} d={d} />)}
    <path class="finial" style={`--i:${n}`} d={dome.finial} />
  </g>
</svg>

<style>
  .dome { width: 100%; height: auto; overflow: visible; }
  .heart, .finial { transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: no-preference) {
    .heart { opacity: 0; animation: gather 0.7s cubic-bezier(0.22, 0.8, 0.26, 1) forwards, glow 1.1s ease-in-out 1; animation-delay: calc(0.1s + var(--i) * 40ms), calc(2.1s + var(--i) * 40ms); }
    .finial { opacity: 0; transform-origin: 50% 100%; animation: rise 0.9s cubic-bezier(0.22, 0.8, 0.26, 1) forwards; animation-delay: calc(0.15s + var(--i) * 40ms); }
  }
  @keyframes gather { from { opacity: 0; transform: translateY(22%) scale(0.5); } to { opacity: 1; transform: none; } }
  @keyframes rise { from { opacity: 0; transform: translateY(12%) scaleY(0.7); } to { opacity: 1; transform: none; } }
  @keyframes glow { 0%, 100% { fill: #cfb083; } 50% { fill: #f6ead2; } }
</style>
