---
// One heart, many masajid: the giving model as a picture.
import dome from '../data/dome.json';
const angles = [-156, -134, -112, -90, -68, -46, -24];
const hx = 260, hy = 452;
const nodes = angles.map((a, i) => {
  const r = i % 2 === 0 ? 318 : 252;
  const x = hx + r * Math.cos((a * Math.PI) / 180);
  const y = hy + r * Math.sin((a * Math.PI) / 180);
  const size = i % 2 === 0 ? 62 : 76;
  const cx = hx + (x - hx) * 0.18, cy = hy - 36 + (y - hy) * 0.72;
  return { x, y, size, d: `M${hx} ${hy - 36}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x.toFixed(1)} ${(y + size * 0.56).toFixed(1)}` };
});
---
<svg class="net" viewBox="-70 84 660 436" role="img" aria-label="One heart at the bottom connected by lines to seven masajid above it.">
  <defs>
    <symbol id="mini-dome" viewBox="4400 4150 12200 12700"><g fill="#CFB083">{dome.hearts.map((d) => <path d={d} />)}<path d={dome.finial} /></g></symbol>
  </defs>
  {nodes.map((n, i) => (
    <g style={`--i:${i}`}>
      <path class="thread" d={n.d} pathLength="1" />
      <use class="node" href="#mini-dome" x={n.x - n.size / 2} y={n.y - n.size / 2} width={n.size} height={n.size} />
    </g>
  ))}
  <g class="giver">
    <circle cx={hx} cy={hy} r="50" />
    <path transform={`translate(${hx - 30} ${hy - 31}) scale(2.5)`} d="M12 21.2C9.6 18.9 3 14.6 3 8.9 3 6 5.1 4 7.6 4c1.9 0 3.4 1.1 4.4 3 1-1.9 2.5-3 4.4-3C18.9 4 21 6 21 8.9c0 5.7-6.6 10-9 12.3z" />
  </g>
</svg>

<style>
  .net { width: 100%; height: auto; overflow: visible; }
  .thread { fill: none; stroke: #cfb083; stroke-width: 1.4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; opacity: 0.75; }
  .giver circle { fill: rgba(207, 176, 131, 0.12); stroke: #cfb083; stroke-width: 1.4; }
  .giver path { fill: #cfb083; }
  .node { transform-box: fill-box; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js [data-reveal]) .thread { stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(0.5, 0, 0.2, 1); transition-delay: calc(0.35s + var(--i) * 0.12s); }
    :global(.js [data-reveal]) .node { opacity: 0; transform: translateY(10px) scale(0.8); transition: opacity 0.6s, transform 0.6s cubic-bezier(0.22, 0.8, 0.26, 1); transition-delay: calc(1.15s + var(--i) * 0.12s); }
    :global(.js [data-reveal].in) .thread { stroke-dashoffset: 0; }
    :global(.js [data-reveal].in) .node { opacity: 1; transform: none; }
  }
</style>
