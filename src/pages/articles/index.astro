---
import Base from '../../layouts/Base.astro';
import Heart from '../../components/Heart.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles } from '../../lib';
const articles = await getArticles();
const cats = ['All', ...new Set(articles.map((a) => a.data.category))];
---
<Base title="The Journal" description="Short articles about masajid: why they matter, what it takes to keep their doors open, and the reward of supporting them.">
  <section class="top mist">
    <div class="wrap">
      <p class="eyebrow"><Heart /> The Journal</p>
      <h1 class="display h1">Short reads on masajid, <em>and why they matter.</em></h1>
      <p class="lede">Faith, community and giving, a few minutes at a time.</p>
      {cats.length > 2 && (
        <div class="chips" role="group" aria-label="Filter articles by topic">
          {cats.map((c, i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c}>{c}</button>)}
        </div>
      )}
    </div>
  </section>

  <section class="list">
    <div class="wrap">
      {articles.length === 0 ? (
        <p class="empty">The first articles are being written. Check back soon.</p>
      ) : (
        <h2 class="sr">All articles</h2>
        <div class="grid" data-grid>
          {articles.map((a, i) => <ArticleCard article={a} eager={i < 2} delay={i % 3} />)}
        </div>
      )}
      <p class="sr" role="status" data-count></p>
      <p class="empty" data-none hidden>No articles on this topic yet. Choose another topic above.</p>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-grid] [data-cat]');
  const none = document.querySelector<HTMLElement>('[data-none]');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter!;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const show = f === 'All' || card.dataset.cat === f;
        card.hidden = !show;
        if (show) { shown++; card.classList.add('in'); }
      });
      if (none) none.hidden = shown > 0;
      const count = document.querySelector('[data-count]');
      if (count) count.textContent = `${shown} ${shown === 1 ? 'article' : 'articles'} shown`;
    }),
  );
</script>

<style>
  .top { padding: clamp(128px, 15vw, 190px) 0 clamp(44px, 6vw, 72px); }
  .top h1 { margin: 16px 0 20px; max-width: 16ch; color: var(--green); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 36px; }
  .chip { min-height: 44px; padding: 0 20px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--white); color: var(--green); font-weight: 600; cursor: pointer; transition: background-color 0.2s, color 0.2s, border-color 0.2s; }
  .chip:hover { border-color: var(--green); }
  .chip[aria-pressed='true'] { background: var(--green); border-color: var(--green); color: var(--white); }
  .list { padding: clamp(44px, 6vw, 80px) 0 var(--section); }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(40px, 5vw, 64px) clamp(24px, 3vw, 40px); }
  .grid :global([hidden]) { display: none; }
  .empty { font-size: 1.1rem; color: var(--ink-soft); padding: 24px 0; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
</style>
